# Leave unset to use the in-memory store
EARNINGSIQ_DATABASE_URL=postgresql://earningsiq:earningsiq@localhost:5432/earningsiq

# hashing (offline, default) | openai
EARNINGSIQ_EMBEDDER=hashing
EARNINGSIQ_EMBEDDING_DIM=512

# extractive (no API key, default) | anthropic | openai
EARNINGSIQ_GENERATOR=extractive
EARNINGSIQ_GENERATOR_MODEL=

EARNINGSIQ_TOP_K=6

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
